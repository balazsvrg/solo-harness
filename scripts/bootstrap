#!/usr/bin/env bash
# Turn a copy of the solo-harness template into a configured project (R18).
#
# Usage:
#   scripts/bootstrap [--dry-run] [--local]   set up this project; safe to run again
#   scripts/bootstrap --template [--dry-run]  template repo: GitHub steps only
#
#   --dry-run  print every action and every gh api call, change nothing
#   --local    skip all GitHub steps
#
# GitHub steps need gh, logged in (gh auth login), in a clone with a GitHub remote:
# repo options, labels, the ruleset (strict or honor mode), and on public repos
# CodeQL and secret-scanning push protection.
#
# Every step checks the current state first and prints "ok" (nothing to do) or a
# "changed" line for each change. Answers come from the terminal, or from BOOTSTRAP_ANSWERS in tests:
# space-separated key=value pairs (name, agents, attribution). A missing key takes
# its default.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../.harness/lib/common.sh
source "$ROOT/.harness/lib/common.sh"
cd "$ROOT"

ALL_AGENTS=(claude codex copilot antigravity)
# Paths each agent needs and no other agent uses (design §6).
declare -A AGENT_PATHS=(
  [claude]='CLAUDE.md .claude'
  [codex]='.codex'
  [copilot]='.github/copilot-instructions.md .github/copilot .github/agents .github/hooks .github/skills .github/workflows/copilot-setup-steps.yml'
  [antigravity]='.agents/hooks.json'
)

TEMPLATE=0 LOCAL=0 DRY_RUN=0 CHANGES=0 FIRST_RUN=1
SELECTED='' NOTES=() SKIPPED=''

# --- output -----------------------------------------------------------------
changed() { CHANGES=$((CHANGES + 1)); log "changed: $*"; }
note() { NOTES+=("$*"); }

# step NAME FUNCTION: run one step. It prints its own "changed" lines, or "ok: NAME".
# A step that could not act sets SKIPPED to the reason.
step() {
  local before=$CHANGES
  SKIPPED=''
  "$2"
  if [[ -n $SKIPPED ]]; then log "skipped: $1 ($SKIPPED)"
  elif ((CHANGES == before)); then log "ok: $1"; fi
}

# --- answers ----------------------------------------------------------------
# ask KEY DEFAULT PROMPT: print the answer for KEY.
ask() {
  local key=$1 def=$2 prompt=$3 pair reply
  if [[ -v BOOTSTRAP_ANSWERS ]]; then
    local pairs
    read -ra pairs <<<"$BOOTSTRAP_ANSWERS"
    for pair in "${pairs[@]}"; do
      [[ $pair == "$key="* ]] && { printf '%s\n' "${pair#*=}"; return; }
    done
    printf '%s\n' "$def"; return
  fi
  if [[ -t 0 ]]; then
    read -r -p "$prompt [$def]: " reply
    printf '%s\n' "${reply:-$def}"
  else
    printf '%s\n' "$def"
  fi
}

# --- files ------------------------------------------------------------------
# write_file FILE CONTENT: write CONTENT and a newline to FILE (only printed in a dry run).
write_file() {
  if ((DRY_RUN)); then printf 'dry-run: write %s\n' "$1"; return; fi
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" > "$1"
}

# json_merge FILE JSON: merge the top-level keys of JSON into FILE, which is created
# if missing. Object values merge one level deep. Writes only when the data changes.
json_merge() {
  local new
  new=$(python3 - "$1" "$2" <<'PY'
import json, os, sys
path, patch = sys.argv[1], json.loads(sys.argv[2])
old = json.load(open(path)) if os.path.exists(path) else None
d = dict(old or {})
for k, v in patch.items():
    d[k] = {**d[k], **v} if isinstance(v, dict) and isinstance(d.get(k), dict) else v
if d != old:
    print(json.dumps(d, indent=2, ensure_ascii=False))
PY
  ) || die "cannot update $1"
  [[ -n $new ]] || return 0
  write_file "$1" "$new"
  changed "$1: $2"
}

# remove PATH: delete a file, folder or symlink if it exists.
remove() {
  [[ -e $1 || -L $1 ]] || return 0
  run rm -rf -- "$1"
  changed "removed $1"
}

# state KEY: a value from .template-version, which the first run writes.
state() { if [[ -f .template-version ]]; then sed -n "s/^$1=//p" .template-version; fi; }

# write_if_different FILE CONTENT WHAT: write FILE when its text is not CONTENT.
write_if_different() {
  [[ -f $1 && $(cat "$1") == "$2" ]] && return 0
  write_file "$1" "$2"
  changed "$3"
}

step_name() {
  local name
  name=$(ask name "$(basename "$ROOT")" 'Project name')
  # Only the template's placeholder title is replaced, so a re-run keeps the owner's text.
  [[ $(head -1 docs/product.md 2>/dev/null) == '# Product' ]] || return 0
  write_file docs/product.md "$(printf '# %s\n' "$name"; tail -n +2 docs/product.md)"
  changed "docs/product.md: title '$name'"
}

step_agents() {
  local list a keep p def
  def=$(state agents)
  [[ -n $def ]] || def=$(IFS=,; echo "${ALL_AGENTS[*]}")
  list=$(ask agents "$def" 'Agents to keep (comma-separated: claude,codex,copilot,antigravity)')
  for a in ${list//,/ }; do
    [[ -v "AGENT_PATHS[$a]" ]] || die "unknown agent: $a"
  done
  local names
  read -ra names <<<"${list//,/ }"
  ((${#names[@]})) || die 'select at least one agent'
  SELECTED="${names[*]}"
  for a in "${ALL_AGENTS[@]}"; do
    keep=0
    [[ " $SELECTED " == *" $a "* ]] && keep=1
    ((keep)) && continue
    for p in ${AGENT_PATHS[$a]}; do remove "$p"; done
  done
}

step_attribution() {
  local ans a none=()
  ans=$(ask attribution keep 'Stop agents adding AI attribution (Co-Authored-By trailers) to commits and PRs? keep/remove')
  case $ans in
    keep) return 0 ;;
    remove) ;;
    *) die "attribution: answer keep or remove, not '$ans'" ;;
  esac
  for a in $SELECTED; do
    case $a in
      claude) json_merge .claude/settings.json '{"attribution": {"commit": "", "pr": "", "sessionUrl": false}}' ;;
      copilot) json_merge .github/copilot/settings.json '{"includeCoAuthoredBy": false}' ;;
      *) none+=("$a") ;;
    esac
  done
  ((${#none[@]} == 0)) || note "no attribution setting: ${none[*]}. Remove their trailers by hand or in your user config."
}

# Step 7. The git hooks run gitleaks; make tools installs it into .harness/bin.
step_git_hooks() {
  if [[ $(git config --get core.hooksPath || true) != .githooks ]]; then
    run git config core.hooksPath .githooks
    changed 'git config core.hooksPath .githooks'
  fi
  [[ -x .harness/bin/gitleaks ]] || command -v gitleaks >/dev/null ||
    note 'gitleaks is not installed, so the pre-commit hook skips the secret scan. Run: make tools'
}

# Step 8. A user-level Claude plugin that ships a skill with the name of a vendored
# skill would load it twice. Plugins are listed in installed_plugins.json, each
# with its installPath (https://code.claude.com/docs/en/plugins/loading.md).
step_plugins() {
  [[ " $SELECTED " == *' claude '* ]] || return 0
  # Output: the settings patch as JSON on the first line, then one note per plugin.
  local out line
  out=$(python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" .agents/skills <<'PY'
import json, os, sys
config, vendored = sys.argv[1], set(os.listdir(sys.argv[2]))
def load(path):
    try: return json.load(open(path))
    except (OSError, ValueError): return {}
enabled = [p for p, on in load(f"{config}/settings.json").get("enabledPlugins", {}).items() if on is True]
installs = load(f"{config}/plugins/installed_plugins.json").get("plugins", {})
off, notes = {}, []
for plugin in enabled:
    skills = set()
    for install in installs.get(plugin, []):
        for root, _, files in os.walk(install.get("installPath", "/nonexistent")):
            if "SKILL.md" in files: skills.add(os.path.basename(root))
    if skills & vendored:
        off[plugin] = False
        notes.append(f"Claude plugin {plugin} is off in this project: it duplicates the vendored skills {' '.join(sorted(skills & vendored))}.")
if off:
    print(json.dumps({"enabledPlugins": off}))
    print("\n".join(notes))
PY
  ) || die 'cannot read the Claude plugin list'
  [[ -n $out ]] || return 0
  json_merge .claude/settings.json "$(head -1 <<<"$out")"
  while IFS= read -r line; do note "$line"; done < <(tail -n +2 <<<"$out")
}

CHANGELOG_HEADER='# Changelog

release-please writes the entries. Do not edit this file by hand.'

# Step 10. The first run records the template version and starts the project at
# 0.1.0; a re-run keeps the project's own version and changelog.
step_template_files() {
  local version line p paths=()
  version=$(state version)
  if [[ -z $version ]]; then
    [[ -f version.txt ]] || die 'version.txt is missing, so the template version is unknown'
    version=$(cat version.txt)
  fi
  # TODO(T10c): add the template repo; --add-agent reads both.
  write_if_different .template-version "$(printf '# Written by scripts/bootstrap.\nversion=%s\nagents=%s' \
    "$version" "${SELECTED// /,}")" .template-version
  if ((FIRST_RUN)); then
    write_if_different version.txt 0.1.0 'version.txt: 0.1.0'
    write_if_different .release-please-manifest.json $'{\n  ".": "0.1.0"\n}' '.release-please-manifest.json: 0.1.0'
    write_if_different CHANGELOG.md "$CHANGELOG_HEADER" 'CHANGELOG.md: template entries removed'
  fi
  [[ -f .template-only ]] || return 0
  mapfile -t paths < <(grep -v -e '^#' -e '^$' .template-only)
  for line in "${paths[@]}"; do
    # Unquoted on purpose: each line is a glob.
    for p in $line; do remove "${p%/}"; done
  done
}

# --- GitHub (R18 steps 4-6) ---------------------------------------------------
# All calls go through gh_api, so tests replace it (.harness/tests/lib/fake_gh.sh).
# gh fills {owner}/{repo} from the git remote of the current folder. Endpoints were
# checked against docs.github.com/en/rest on 2026-11-13.
REPO_API='repos/{owner}/{repo}'

# gh_api ARGS...: `gh api ARGS`. The body goes to stdout; on failure gh exits non-zero
# and its stderr names the status, for example "gh: Not Found (HTTP 404)".
gh_api() {
  command -v gh >/dev/null || { echo 'gh: GitHub CLI is not installed' >&2; return 1; }
  gh api "$@"
}

# gh_shown ARGS...: the arguments as one line, with quotes around those that have spaces.
gh_shown() {
  local a shown=()
  for a in "$@"; do [[ $a == *[[:space:]]* ]] && a="'$a'"; shown+=("$a"); done
  printf '%s' "${shown[*]}"
}

# gh_call ARGS...: run gh_api and print the body. Returns 3 on HTTP 403 (the plan or
# the token does not allow it); on other errors prints the error and returns 1.
gh_call() {
  local body err errfile rc=0
  errfile=$(mktemp)
  body=$(gh_api "$@" 2>"$errfile") || rc=$?
  err=$(cat "$errfile"); rm -f "$errfile"
  if ((rc == 0)); then printf '%s' "$body"; return 0; fi
  [[ $err == *'(HTTP 403)'* ]] && return 3
  err "gh api $(gh_shown "$@"): $err"
  return 1
}

# gh_read ARGS...: a GitHub read. A dry run also does it, and prints it on stderr
# (stdout carries the body).
gh_read() {
  ((DRY_RUN)) && printf 'dry-run: read: gh api %s\n' "$(gh_shown "$@")" >&2
  gh_call "$@"
}

# gh_write ARGS...: a GitHub write. A dry run only prints it. Returns like gh_call.
gh_write() {
  if ((DRY_RUN)); then printf 'dry-run: gh api %s\n' "$(gh_shown "$@")"; return 0; fi
  gh_call "$@" >/dev/null
}

# gh_stop WHAT STATUS: stop bootstrap after a write to WHAT failed with gh_call STATUS.
gh_stop() {
  (($2 == 3)) && die "GitHub refused to change $1 (HTTP 403). Run bootstrap as an admin of the repo."
  die "cannot change $1 on GitHub"
}

# py_json EXPR [ARGS...]: evaluate a Python expression over the JSON on stdin (as `d`,
# extra arguments as `a`). Lists print one item per line, strings print raw.
py_json() {
  python3 -c 'import json, sys
text, dec, docs, i = sys.stdin.read(), json.JSONDecoder(), [], 0
while i < len(text.rstrip()):  # gh --paginate prints one JSON document per page
    while text[i].isspace(): i += 1
    doc, i = dec.raw_decode(text, i); docs.append(doc)
d = docs[0] if len(docs) == 1 else sum(docs, [])
a = sys.argv[2:]
def sub(w, h):
    """True if h has every value of w; GitHub adds fields and may reorder lists."""
    if isinstance(w, dict):
        return isinstance(h, dict) and all(sub(v, h[k]) if k in h else v in ([], {}, None) for k, v in w.items())
    if isinstance(w, list):
        return isinstance(h, list) and len(w) == len(h) and all(any(sub(x, y) for y in h) for x in w)
    return w == h
r = eval(sys.argv[1])
for x in (r if isinstance(r, list) else [r]):
    print(x if isinstance(x, str) else json.dumps(x))' "$@"
}

REPO_JSON='' MODE='' REPO_URL=''

# Step 4: squash merge only; the squash commit gets the PR title and the list of
# commit messages; merged branches are deleted.
step_repo_options() {
  local fields
  # A plain python3 block, not py_json: it needs statements, not one expression.
  fields=$(python3 -c 'import json, sys
want = {"allow_squash_merge": True, "allow_merge_commit": False, "allow_rebase_merge": False,
        "delete_branch_on_merge": True, "squash_merge_commit_title": "PR_TITLE",
        "squash_merge_commit_message": "COMMIT_MESSAGES"}
have = json.load(sys.stdin)
diff = [k for k in want if have.get(k) != want[k]]
if any(k.startswith("squash_") for k in diff):  # GitHub wants these two together
    diff = [k for k in want if k in diff or k.startswith("squash_")]
print(" ".join(f"-F {k}={json.dumps(want[k]).strip(chr(34))}" for k in diff))' <<<"$REPO_JSON") ||
    die 'cannot read the repo options'
  [[ -n $fields ]] || return 0
  # shellcheck disable=SC2086 # each item is "-F key=value"
  gh_write -X PATCH "$REPO_API" $fields || gh_stop 'the repo options' $?
  changed "repo options: ${fields//-F /}"
}

# name|color|description
LABELS=(
  'size/S|0e8a16|Small change: no new or changed requirement'
  'size/M|fbca04|Medium change: new behaviour inside one capability'
  'size/L|d93f0b|Large change: spans capabilities or is hard to reverse'
  'size-exception|b60205|Allowed to exceed the size limits'
  'agent|5319e7|Opened or changed by an AI agent'
  'dependencies|0366d6|Dependency update'
)

# Step 5. GitHub label names ignore case, so "Size/S" counts as size/S.
step_labels() {
  local have line name color desc
  have=$(gh_read --paginate "$REPO_API/labels?per_page=100" | py_json '[l["name"].lower() for l in d]') ||
    die 'cannot read the repo labels'
  for line in "${LABELS[@]}"; do
    IFS='|' read -r name color desc <<<"$line"
    grep -qxF "${name,,}" <<<"$have" && continue
    gh_write -X POST "$REPO_API/labels" -f "name=$name" -f "color=$color" -f "description=$desc" || gh_stop "label $name" $?
    changed "label $name"
  done
}

# Step 6 (R15). The ruleset with the name in .github/ruleset.json is created, or
# updated when it differs. GitHub answers 403 when the plan has no rulesets for this
# repo (a private repo on GitHub Free): that is honor mode.
step_ruleset() {
  local file=.github/ruleset.json name list id='' current rc=0
  name=$(py_json 'd["name"]' <"$file") || die "cannot read $file"
  # Only this repo's rulesets: an organization ruleset with the same name is not ours.
  list=$(gh_read "$REPO_API/rulesets?includes_parents=false") || rc=$?
  if ((rc == 0)); then
    id=$(py_json '[str(r["id"]) for r in d if r["name"] == a[0]]' "$name" <<<"$list" | head -1)
    if [[ -z $id ]]; then
      gh_write -X POST "$REPO_API/rulesets" --input "$file" || rc=$?
      ((rc == 0)) && changed "ruleset $name created"
    else
      current=$(gh_read "$REPO_API/rulesets/$id") || rc=$?
      if ((rc == 0)) && [[ $(py_json 'sub(json.load(open(a[0])), d)' "$file" <<<"$current") != true ]]; then
        gh_write -X PUT "$REPO_API/rulesets/$id" --input "$file" || rc=$?
        ((rc == 0)) && changed "ruleset $name updated"
      fi
    fi
  fi
  case $rc in
    0) MODE=strict ;;
    3) MODE=honor SKIPPED='GitHub answered 403: honor mode' ;;
    *) die "cannot apply the ruleset $name" ;;
  esac
}

# Step 6, public repos only: CodeQL default setup and secret-scanning push protection.
# Private repos need GitHub Advanced Security for both, so bootstrap skips them.
step_security() {
  if [[ $(py_json 'd.get("visibility")' <<<"$REPO_JSON") != public ]]; then
    note 'CodeQL and secret-scanning push protection are skipped: they need a public repo or GitHub Advanced Security.'
    return 0
  fi
  local setup rc=0
  setup=$(gh_read "$REPO_API/code-scanning/default-setup") || rc=$?
  if ((rc == 0)) && [[ $(py_json 'd.get("state")' <<<"$setup") != configured ]]; then
    gh_write -X PATCH "$REPO_API/code-scanning/default-setup" -f state=configured || rc=$?
    ((rc == 0)) && changed 'CodeQL default setup turned on'
  fi
  ((rc == 0)) || note 'GitHub refused CodeQL default setup. Turn it on in Settings > Code security.'
  if [[ $(py_json '[(d.get("security_and_analysis") or {}).get(k, {}).get("status")
      for k in ("secret_scanning", "secret_scanning_push_protection")]' <<<"$REPO_JSON") != $'enabled\nenabled' ]]; then
    rc=0
    gh_write -X PATCH "$REPO_API" -f 'security_and_analysis[secret_scanning][status]=enabled' \
      -f 'security_and_analysis[secret_scanning_push_protection][status]=enabled' || rc=$?
    if ((rc == 0)); then changed 'secret scanning and push protection turned on'
    else note 'GitHub refused secret-scanning push protection. Turn it on in Settings > Code security.'; fi
  fi
}

github_steps() {
  REPO_JSON=$(gh_read "$REPO_API") ||
    die "cannot read the GitHub repo of this folder. Run 'gh auth login' and check the git remote, or use --local."
  REPO_URL=$(py_json 'd.get("html_url", "")' <<<"$REPO_JSON")
  step 'repo options' step_repo_options
  step labels step_labels
  step ruleset step_ruleset
  step 'security features' step_security
}

# Step 9: what only the owner can do, one step at a time (wizard style). In a terminal
# each step waits for Enter; otherwise the list is printed.
human_steps() {
  local steps=() a i
  if ((TEMPLATE)) && [[ -n $REPO_URL ]]; then
    steps+=("Mark the repo as a template: open $REPO_URL/settings and tick \"Template repository\" under General.")
  fi
  local where='Settings > Secrets and variables > Actions of the GitHub repo'
  [[ -z $REPO_URL ]] || where=$REPO_URL/settings/secrets/actions
  steps+=("Optional: add the secret RELEASE_PLEASE_TOKEN (a fine-grained token with contents and pull requests write) at $where, so CI runs on release PRs. Without it, close and reopen each release PR before you merge it.")
  for a in $SELECTED; do
    case $a in
      claude) steps+=('Claude Code: start claude in this folder and trust it, so the project settings and hooks load.') ;;
      codex) steps+=('Codex: trust this project, then run /hooks and trust each hook. Codex trusts a hook by its hash, so do it again after a hook changes.') ;;
      antigravity) steps+=("Antigravity: add this folder to trustedWorkspaces in your Antigravity settings, so .agents/hooks.json loads.") ;;
    esac
  done
  ((${#steps[@]})) || return 0
  log ''
  log "Steps only you can do (${#steps[@]}):"
  for i in "${!steps[@]}"; do
    log "  [$((i + 1))/${#steps[@]}] ${steps[i]}"
    if ((!DRY_RUN)) && [[ -t 0 && -t 1 ]]; then read -r -p '        Press Enter when done. ' _ || true; fi
  done
}

summary() {
  local n
  log ''
  if ((DRY_RUN)); then log "dry run: $CHANGES change(s) planned, nothing written"
  else log "done: $CHANGES change(s)"; fi
  for n in "${NOTES[@]}"; do log "note: $n"; done
  case $MODE in
    strict) log 'GitHub: strict mode. The ruleset protects main.' ;;
    honor)
      log ''
      log '*** GitHub: honor mode ***'
      log '  GitHub refused the ruleset (HTTP 403): a private repo on GitHub Free has no'
      log '  rulesets. CI still runs and reports, and the agent deny rules still forbid'
      log '  merging and pushing to main. GitHub does not block a merge, so merging is your decision.'
      log '  For strict mode, make the repo public or change the plan, then run bootstrap again.'
      ;;
  esac
  ((TEMPLATE)) && return 0
  if grep -qx '# solo-harness:check-app-placeholder' Makefile; then
    log ''
    # shellcheck disable=SC2016 # literal backticks
    log '*** next: configure `check-app` ***'
    log '  The check-app target in the Makefile is a placeholder. It fails as soon as'
    log '  the repo has source code. Replace its recipe with your project checks and'
    log '  delete the marker line. The README section on overlays shows examples.'
  fi
  log ''
  log 'Then: map your source folders to their docs in .docs-map, and run the'
  log 'lifecycle (grill-with-docs, to-spec, ...) on your first change.'
}

main() {
  while (($#)); do
    case $1 in
      --template) TEMPLATE=1 ;;
      --local) LOCAL=1 ;;
      --dry-run) DRY_RUN=1 ;;
      -h | --help) sed -n '2,/^set -euo/{/^set/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
      *) die "unknown argument: $1 (see --help)" ;;
    esac
    shift
  done
  if ((TEMPLATE)); then
    # The template repo itself: never delete, rename or rewrite a file.
    ((LOCAL)) || github_steps
    human_steps
  else
    FIRST_RUN=1
    [[ -f .template-version ]] && FIRST_RUN=0
    step 'project name' step_name
    step agents step_agents
    step 'AI attribution' step_attribution
    ((LOCAL)) || github_steps
    step 'git hooks' step_git_hooks
    step 'Claude plugins' step_plugins
    human_steps
    step 'template files' step_template_files
  fi
  summary
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
