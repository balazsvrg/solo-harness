{
  "solo-harness": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.harness/hooks/adapter.sh\" antigravity pre", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.harness/hooks/adapter.sh\" antigravity post", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.harness/hooks/adapter.sh\" antigravity stop", "timeout": 300 }
        ]
      }
    ]
  }
}
